{
  "name": "everything-runner",
  "productName": "Everything Runner",
  "version": "1.0.0",
  "description": "Spotlight-style macOS on-the-fly script & text tool executor",
  "main": "dist/electron/main.js",
  "directories": {
    "test": "src/test"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "install:mac": "npm run package:mac && node scripts/install-mac.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin-js": "^2.9.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "electron": "^33.2.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
